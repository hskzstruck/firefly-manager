{
  "name": "firefly-manager",
  "displayName": "firefly-manager",
  "description": "display my wife",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.136.0"
  },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "secondarySidebar": [
                {
                    "id": "fireflyContainer",
                    "title": "Firefly",
                    "icon": "media/firefly_02.webp"
                }
            ]
        },
        "views": {
    "fireflyContainer": [
        {
            "type": "webview",
            "id": "fireflyView",
            "name": "",
            "icon": "media/firefly_02.webp"
        }
]
},
        "commands": [
            {
                "command": "firefly-manager.helloWorld",
                "title": "Hello World"
            }
        ]
    },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.136.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
